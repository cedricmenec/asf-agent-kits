{
  "name": "@asf/agent-kits-catalogue",
  "version": "0.0.0-private-r0",
  "private": true,
  "type": "module",
  "description": "ASF Agent Kits catalogue and local Node.js LTS installer",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
