#!/usr/bin/env node
import { main } from '../tools/asf_agentkit_cli.mjs';
try {
  if (Number(process.versions.node.split('.')[0]) !== 26) throw new Error('Node.js 26 LTS is required');
  process.exitCode = await main();
}
catch (error) { console.error('ASF-AgentKit REFUSED: ' + error.message); process.exitCode = 3; }
