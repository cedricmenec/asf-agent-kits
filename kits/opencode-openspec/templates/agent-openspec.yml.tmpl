# Generated from ASF AgentKit. Do not activate before manual GitHub setup/review.
# Manual, first-attempt, owner-only, one paid phase per explicit authorization.
# OpenCode never receives GitHub App publication credentials.
name: AgentKit OpenSpec (manual)

on:
  workflow_dispatch:
    inputs:
      task_id:
        description: 'Existing backlog task (e.g. 9 or @@TASKPREFIX@@-009)'
        required: true
        type: string
      phase:
        description: 'One paid phase; no auto/retry'
        required: true
        type: choice
        default: plan
        options: [plan, apply, finalize]
      model:
        description: 'Explicit allowlisted OpenRouter model'
        required: true
        type: choice
        default: openrouter/deepseek/deepseek-v4.1-flash-1017
        options:
          - openrouter/deepseek/deepseek-v4.1-flash
          - openrouter/deepseek/deepseek-v4.1-flash-1017
          - openrouter/z-ai/glm-5.3-flash
      paid_approval:
        description: 'For THIS run type I_AUTHORIZE_ONE_PAID_PHASE'
        required: true
        type: string

permissions:
  contents: read

jobs:
  prepare:
    if: github.actor == github.repository_owner && github.ref == 'refs/heads/@@DEFAULTBRANCH@@' && github.run_attempt == 1
    runs-on: ubuntu-24.04
    permissions:
      contents: read
    outputs:
      taskId: ${{ steps.request.outputs.taskId }}
      branch: ${{ steps.request.outputs.branch }}
      change: ${{ steps.request.outputs.change }}
      observedTip: ${{ steps.request.outputs.observedTip }}
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: '22'
      - name: Verify owner request and source prerequisites before a paid job
        id: request
        env:
          RAW_TASK_ID: ${{ inputs.task_id }}
          PHASE: ${{ inputs.phase }}
          OPENCODE_MODEL: ${{ inputs.model }}
          PAID_APPROVAL: ${{ inputs.paid_approval }}
          APP_ID_PRESENT: ${{ vars.@@APPIDVAR@@ }}
          APP_PRIVATE_KEY_PRESENT: ${{ secrets.@@APPPRIVATEKEYSECRET@@ }}
          PROVIDER_KEY_PRESENT: ${{ secrets.@@OPENROUTERSECRET@@ }}
        shell: bash
        run: |
          set -euo pipefail
          test -n "$APP_ID_PRESENT" && test -n "$APP_PRIVATE_KEY_PRESENT" && test -n "$PROVIDER_KEY_PRESENT" || {
            echo "::error::Required App/provider setup missing; inspect manual-acceptance.md"; exit 1
          }
          test -f .asf/agentkit/runtime/request.mjs
          node .asf/agentkit/runtime/request.mjs

  execute:
    needs: prepare
    runs-on: ubuntu-24.04
    timeout-minutes: 60
    concurrency:
      group: @@MUTEXGROUP@@
      cancel-in-progress: false
    permissions:
      contents: read
    env:
      PHASE: ${{ inputs.phase }}
      TASK_ID: ${{ needs.prepare.outputs.taskId }}
      CHANGE_ID: ${{ needs.prepare.outputs.change }}
      AGENT_BRANCH: ${{ needs.prepare.outputs.branch }}
      OBSERVED_TIP: ${{ needs.prepare.outputs.observedTip }}
      OPENCODE_MODEL: ${{ inputs.model }}
      OPENROUTER_API_KEY: ${{ secrets.@@OPENROUTERSECRET@@ }}
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: '22'
      - name: Load trusted policies and select exact observed branch
        shell: bash
        run: |
          set -euo pipefail
          test -n "$OPENROUTER_API_KEY" || { echo "::error::Provider key unavailable"; exit 1; }
          for file in scope.mjs model-policy.mjs checklist.mjs phase.sh; do
            git show "$GITHUB_SHA:.asf/agentkit/runtime/$file" > "$RUNNER_TEMP/$file"
            test -s "$RUNNER_TEMP/$file"
          done
          if [[ "$OBSERVED_TIP" == absent ]]; then
            git switch -c "$AGENT_BRANCH"
          else
            git fetch --no-tags origin "refs/heads/$AGENT_BRANCH"
            test "$(git rev-parse FETCH_HEAD)" = "$OBSERVED_TIP" || {
              echo "::error::Agent branch moved after preflight"; exit 1
            }
            git switch -c "$AGENT_BRANCH" "$OBSERVED_TIP"
          fi
      - name: Install fixed OpenSpec and OpenCode binaries
        shell: bash
        run: |
          set -euo pipefail
          npm install --global @fission-ai/openspec@1.14.1 opencode-ai@1.19.0
          openspec --version
          test "$(opencode --version)" = 1.19.0
      - name: Configure trusted model policy
        run: node "$RUNNER_TEMP/model-policy.mjs"
      - name: Execute exactly one authorized OpenSpec phase
        shell: bash
        run: bash "$RUNNER_TEMP/phase.sh"
      - name: Verify model changes and create untrusted patch artifact
        shell: bash
        run: |
          set -euo pipefail
          node "$RUNNER_TEMP/scope.mjs" all "$PHASE" "$CHANGE_ID"
          git add -A
          node "$RUNNER_TEMP/scope.mjs" staged "$PHASE" "$CHANGE_ID"
          git diff --cached --binary > "$RUNNER_TEMP/agentkit.patch"
          test -s "$RUNNER_TEMP/agentkit.patch"
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: agentkit-reviewed-scope-patch
          path: ${{ runner.temp }}/agentkit.patch
          if-no-files-found: error
          retention-days: 1

  publish:
    needs: [prepare, execute]
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    permissions:
      contents: read
    env:
      PHASE: ${{ inputs.phase }}
      TASK_ID: ${{ needs.prepare.outputs.taskId }}
      CHANGE_ID: ${{ needs.prepare.outputs.change }}
      AGENT_BRANCH: ${{ needs.prepare.outputs.branch }}
      OBSERVED_TIP: ${{ needs.prepare.outputs.observedTip }}
      DEFAULT_BRANCH: '@@DEFAULTBRANCH@@'
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4
        with:
          name: agentkit-reviewed-scope-patch
          path: ${{ runner.temp }}/agentkit-patch
      - name: Prepare trusted guard and check exact remote refs
        shell: bash
        run: |
          set -euo pipefail
          git show "$GITHUB_SHA:.asf/agentkit/runtime/scope.mjs" > "$RUNNER_TEMP/scope.mjs"
          git fetch --no-tags origin "refs/heads/$DEFAULT_BRANCH"
          test "$(git rev-parse FETCH_HEAD)" = "$GITHUB_SHA" || {
            echo "::error::Default branch moved since owner dispatch"; exit 1
          }
          remote_tip="$(git ls-remote --heads origin "refs/heads/$AGENT_BRANCH" | cut -f1)"
          if [[ "$OBSERVED_TIP" == absent ]]; then
            test -z "$remote_tip" || { echo "::error::Branch appeared since preflight"; exit 1; }
            git switch -c "$AGENT_BRANCH"
          else
            test "$remote_tip" = "$OBSERVED_TIP" || { echo "::error::Branch moved since preflight"; exit 1; }
            git fetch --no-tags origin "refs/heads/$AGENT_BRANCH"
            test "$(git rev-parse FETCH_HEAD)" = "$OBSERVED_TIP"
            git switch -c "$AGENT_BRANCH" "$OBSERVED_TIP"
          fi
          git apply --check --index "$RUNNER_TEMP/agentkit-patch/agentkit.patch"
          git apply --index "$RUNNER_TEMP/agentkit-patch/agentkit.patch"
          node "$RUNNER_TEMP/scope.mjs" staged "$PHASE" "$CHANGE_ID"
      - uses: actions/create-github-app-token@d72941d797fd3113feb6b93fd0dec494b13a2547 # v1.12.0
        id: app-token
        with:
          app-id: ${{ vars.@@APPIDVAR@@ }}
          private-key: ${{ secrets.@@APPPRIVATEKEYSECRET@@ }}
          permission-contents: write
          permission-pull-requests: write
      - name: Publish ordinary branch and draft PR only
        env:
          GH_TOKEN: ${{ steps.app-token.outputs.token }}
        shell: bash
        run: |
          set -euo pipefail
          test -n "$GH_TOKEN"
          git config user.name "asf-agentkit[bot]"
          git config user.email "asf-agentkit[bot]@users.noreply.github.com"
          git commit -m "agent($TASK_ID): OpenSpec $PHASE"
          git -c http.extraheader="AUTHORIZATION: basic $(printf 'x-access-token:%s' "$GH_TOKEN" | base64 -w0)" push origin "HEAD:refs/heads/$AGENT_BRANCH"
          existing="$(gh pr list --repo "$GITHUB_REPOSITORY" --head "$AGENT_BRANCH" --state open --json number --jq '.[0].number // empty')"
          if [[ -z "$existing" ]]; then
            gh pr create --repo "$GITHUB_REPOSITORY" --draft --base "$DEFAULT_BRANCH" --head "$AGENT_BRANCH" \
              --title "OpenSpec: $TASK_ID" \
              --body "Phase $PHASE. Independent CI and manual acceptance required. No auto-merge or operational approval is implied."
          else
            echo "Existing draft/review PR #$existing updated; no merge requested."
          fi
