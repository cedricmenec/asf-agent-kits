{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:asf:agentkit:release:1",
  "title": "ASF AgentKit immutable release manifest (provisional R0)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kitId", "kitVersion", "coreVersion", "sourceRepository", "sourceCommitSha", "releaseTag", "runtime", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kitId": { "enum": ["opencode-openspec", "opencode-direct"] },
    "kitVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "coreVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "sourceRepository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "sourceCommitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "releaseTag": { "type": "string", "pattern": "^kits/[a-z0-9-]+/v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["nodeVersion", "openCodeVersion", "openSpecVersion"],
      "properties": {
        "nodeVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "openCodeVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "openSpecVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
