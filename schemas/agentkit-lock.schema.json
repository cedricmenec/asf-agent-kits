{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:asf:agentkit:lock:1",
  "title": "ASF AgentKit installation lock (provisional R0)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kits"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kits": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "version", "sourceRepository", "releaseTag", "sourceCommitSha", "coreVersion", "configSchemaVersion", "managedFiles"],
        "properties": {
          "id": { "enum": ["opencode-openspec", "opencode-direct"] },
          "version": { "$ref": "#/$defs/version" },
          "sourceRepository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
          "releaseTag": { "type": "string", "pattern": "^kits/[a-z0-9-]+/v[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "sourceCommitSha": { "$ref": "#/$defs/sha1" },
          "coreVersion": { "$ref": "#/$defs/version" },
          "configSchemaVersion": { "const": 1 },
          "managedFiles": {
            "type": "object", "minProperties": 1,
            "propertyNames": { "type": "string", "minLength": 1 },
            "additionalProperties": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
