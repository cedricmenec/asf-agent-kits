{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:asf:agentkit:release-claim:1",
  "title": "Untrusted AgentKit release claim: never a provenance attestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "kitId", "kitVersion", "sourceRepository", "sourceCommitSha", "releaseTag", "claimedTagTargetCommitSha", "manifestSha256", "artifacts"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "untrusted-release-claim"},
    "kitId": {"enum": ["opencode-direct", "opencode-openspec"]},
    "kitVersion": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "sourceRepository": {"type": "string", "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,99}/[A-Za-z0-9_-][A-Za-z0-9_.-]{0,99}$"},
    "sourceCommitSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "releaseTag": {"type": "string", "pattern": "^kits/(opencode-direct|opencode-openspec)/v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "claimedTagTargetCommitSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "manifestSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifacts": {
      "type": "array", "minItems": 1, "maxItems": 250,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 512},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
